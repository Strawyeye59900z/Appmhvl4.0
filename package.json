{
  "name": "condominio-app",
  "version": "0.1.0",
  "private": true,
  "description": "Sistema de gestão condominial — encomendas, reservas, facial Hikvision, WhatsApp",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm run start:dev -w @condominio/api",
    "dev:web": "npm run dev -w @condominio/web",
    "build": "npm run build -w @condominio/shared && npm run build -w @condominio/api && npm run build -w @condominio/web",
    "lint": "npm run lint --workspaces --if-present",
    "prisma:generate": "prisma generate --schema=./prisma/schema.prisma",
    "prisma:migrate:dev": "prisma migrate dev --schema=./prisma/schema.prisma",
    "prisma:migrate:deploy": "prisma migrate deploy --schema=./prisma/schema.prisma",
    "seed": "npm run seed -w @condominio/api"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "devDependencies": {
    "prisma": "^5.22.0",
    "typescript": "^5.6.3"
  }
}
